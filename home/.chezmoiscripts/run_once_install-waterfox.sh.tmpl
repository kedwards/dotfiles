{{ if .enable_desktop -}}
#!/bin/bash
set -eu

command -v waterfox >/dev/null && exit 0

. /etc/os-release
repo="https://download.opensuse.org/repositories/isv:/BrowserWorks/Debian_${VERSION_ID}"
curl -fsSL "${repo}/Release.key" | gpg --dearmor | sudo tee /usr/share/keyrings/waterfox.gpg >/dev/null
echo "deb [signed-by=/usr/share/keyrings/waterfox.gpg] ${repo}/ /" | sudo tee /etc/apt/sources.list.d/waterfox.list >/dev/null
sudo apt-get update
sudo apt-get install -y waterfox
{{ end -}}
