{{ if .is_debian -}}
#!/bin/bash
# 1Password CLI everywhere on Debian; desktop app only when enable_desktop is on
set -eu

[ "$(uname -m)" = x86_64 ] || {
	echo "1Password: unsupported architecture $(uname -m)" >&2
	exit 1
}

BASE_URL="https://downloads.1password.com/linux/debian/amd64/stable"

install_deb() {
	local tmp
	tmp="$(mktemp --suffix=.deb)"
	trap 'rm -f "$tmp"' RETURN
	curl -fsSL "$BASE_URL/$1" -o "$tmp"
	sudo apt install -y "$tmp"
}

command -v op >/dev/null || install_deb 1password-cli-amd64-latest.deb
{{- if .enable_desktop }}
command -v 1password >/dev/null || install_deb 1password-latest.deb
{{- end }}
{{ end -}}
