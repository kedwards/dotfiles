{{ if and .is_debian .enable_desktop -}}
#!/bin/bash
set -eu

command -v 1password >/dev/null && exit 0

TMP_DEB="$(mktemp --suffix=.deb)"
trap 'rm -f "$TMP_DEB"' EXIT

curl -fsSL "https://downloads.1password.com/linux/debian/amd64/stable/1password-latest.deb" -o "$TMP_DEB"
sudo apt install -y "$TMP_DEB"
{{ end -}}
