#!/bin/bash
# Installs the mise tools; re-runs whenever the tool list changes
# tools hash: {{ include "dot_config/mise/conf.d/kedwards-tools.toml" | sha256sum }}
set -eu

MISE="$(command -v mise || echo "$HOME/.local/bin/mise")"
[ -x "$MISE" ] || {
	echo "mise not found; install it first" >&2
	exit 1
}

"$MISE" trust "$HOME/.config/mise/conf.d/kedwards-tools.toml"
"$MISE" install
"$HOME/.local/bin/git-tools" install-completion
