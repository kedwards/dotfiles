#!/bin/bash
# packages hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -eu

MISE="$HOME/.local/bin/mise"

if [ ! -x "$MISE" ]; then
	echo "mise not found at $MISE; run debian-sysinit seed/bootstrap.sh first" >&2
	exit 1
fi

"$MISE" trust "$HOME/.config/mise/config.toml"
"$MISE" install
"$HOME/.local/bin/git-tools" install-completion
