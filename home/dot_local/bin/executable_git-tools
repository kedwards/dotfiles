#!/usr/bin/env bash
set -euo pipefail

install_completion() {
	local shell="${1:-${SHELL_TYPE:-$(basename "${SHELL:-bash}")}}"
	local dir file url version url_suffix

	case "$shell" in
	bash)
		dir="$HOME/.local/share/bash-completion/completions"
		file="$dir/git-completion.bash"
		url_suffix="bash"
		;;
	zsh)
		dir="$HOME/.zsh/completions"
		file="$dir/_git"
		url_suffix="zsh"
		;;
	*)
		echo "Unsupported shell: $shell" >&2
		return 1
		;;
	esac

	mkdir -p "$dir"

	version="$(git --version | awk '{print $3}')"
	url="https://raw.githubusercontent.com/git/git/v${version}/contrib/completion/git-completion.${url_suffix}"

	curl -fsSL "$url" -o "$file"
}

case "${1:-install-completion}" in
install-completion)
	shift || true
	install_completion "${1:-}"
	;;
*)
	echo "git-tools install-completion [bash|zsh]" >&2
	exit 1
	;;
esac
