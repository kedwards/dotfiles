# DO NOT EDIT THIS FILE - Generated by chezmoi tempplate

# Common history settings (shell-agnostic)
export HISTSIZE=500000
export HISTFILESIZE=100000
# Enable autocd (implicit `cd` when typing a directory)
shopt -s autocd 2>/dev/null

# Enable recursive globbing (** to match subdirectories)
shopt -s globstar 2>/dev/null

# Enable multi-line commands in history
shopt -s cmdhist

# Append to history file instead of overwriting
shopt -s histappend

# Append commands immediately (not at end of session) without clobbering
# existing prompt hooks such as Warp's shell integration.
__history_append_prompt_command() {
  history -a
}

if declare -p PROMPT_COMMAND >/dev/null 2>&1 && declare -p PROMPT_COMMAND 2>/dev/null | grep -q 'declare \-a'; then
  PROMPT_COMMAND=(__history_append_prompt_command "${PROMPT_COMMAND[@]}")
elif [ -n "${PROMPT_COMMAND:-}" ]; then
  case ";${PROMPT_COMMAND};" in
    *";__history_append_prompt_command;"*) ;;
    *) PROMPT_COMMAND="__history_append_prompt_command; ${PROMPT_COMMAND}" ;;
  esac
else
  PROMPT_COMMAND="__history_append_prompt_command"
fi

export PROMPT_COMMAND

# Prevent duplicate lines and lines starting with space from being recorded in history
export HISTCONTROL="erasedups:ignoreboth"
export HISTIGNORE="clear:&:[ ]*:exit:ls:[bf]g:history:date:* --help"

# Set history timestamp format
export HISTTIMEFORMAT='%F %T '

# Automatically trim long paths in the prompt (only works in Bash 4.x+)
PROMPT_DIRTRIM=2
