{{- $shell := env "SHELL" | base -}}
{{- if eq $shell "bash" }}

set -o vi
bind 'set show-mode-in-prompt on'
bind 'set vi-cmd-mode-string "\1\e[31m\2\1\e[0m\2 "'
bind 'set vi-ins-mode-string "\1\e[32m\2\1\e[0m\2 "'

{{- else if eq $shell "zsh" }}

bindkey -v

{{- end }}

export EDITOR=nvim

SHELL_TYPE="{{ $shell }}"
export SHELL_TYPE